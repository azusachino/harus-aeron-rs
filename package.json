{
  "name": "harus-aeron-rs-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "astro:dev": "astro dev --host 127.0.0.1 --port 8000",
    "astro:check": "astro sync && tsc -p tsconfig.json && bun test src/markdown/resolve-doc-links.test.ts",
    "astro:build": "bun run astro:check && astro build",
    "astro:preview": "astro preview",
    "astro:e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@playwright/test": "1.60.0",
    "@types/bun": "1.4.3",
    "astro": "7.3.5",
    "mermaid": "11.17.2",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "1.1.2",
    "typescript": "7.0.2"
  }
}
